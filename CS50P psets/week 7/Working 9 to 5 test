import pytest
from working import convert


def test_output():
    assert convert("11:05 AM to 5 PM") == "11:05 to 17:00"
    assert convert("11 AM to 5:30 PM") == "11:00 to 17:30"
    assert convert("5 AM to 5 PM") == "05:00 to 17:00"
    assert convert("3:30 AM to 7:40 PM") == "03:30 to 19:40"
    assert convert("12 AM to 12 PM") == "00:00 to 12:00"
    assert convert("9:59 AM to 5:59 PM") == "09:59 to 17:59"


def test_error():
    with pytest.raises(ValueError):
        convert("00:00 AM to 5:00 PM")    
    with pytest.raises(ValueError):  
        convert("cat")
    with pytest.raises(ValueError): 
        convert("9:60 AM to 5:40 PM")
    with pytest.raises(ValueError):
        convert("9:5 AM to 5:00 PM")
