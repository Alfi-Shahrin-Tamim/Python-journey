stock = {
    "apple": 10,
    "banana": 3,
    "mango": 8,
    "grape": 2
}

sales = [
    ("apple", 3),
    ("banana", 2),
    ("mango", 5),
    ("grape", 2),
    ("banana", 1)
]

out_stock = []
low_stock = []

for item, cost in sales:
    if item in stock:
        stock[item] -= cost
        val = stock[item]

        if val == 0:
            if item not in out_stock:
                out_stock.append(item)
        elif 0 < val < 5:
            if item not in low_stock:
                low_stock.append(item)

print("Out of stock:")
for name in out_stock:
    print(name)

print("\nLow stock:")
for name in low_stock:
    print(name)
