item = {"apple": 60, "orange": 80, "banana": 45, "mango": 90, "strawberry": 95}

new = {}

def filter(d, d1):
    bar = int(input("What is the minimum value? "))
    for name, value in d.items():
        if value >= bar:
            d1[name] = value

filter(item, new)

for name, value in new.items():
    print(f"{name}: {value}")
