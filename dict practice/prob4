people = {"Alice": 20, "Bob": 19, "Charlie": 21}

people["George"] = 18
people["Bob"] = 22
people["Sam"] = people.get("Sam", 0) + 10

for name, age in people.items():
    print(f"{name} is {age}")

print("Next loop\n")

people.pop("Bob")

for name, age in people.items():
    print(f"{name} is {age}")
